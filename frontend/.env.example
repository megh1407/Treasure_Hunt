# ==============================================================================
# CORE QUEST FINDER — FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# Platform: Vercel (Vite + React)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API TARGET
# ------------------------------------------------------------------------------
# URL of your deployed Render backend API.
# - If connecting directly across origins (Recommended for Vercel -> Render):
#   Set to your full Render backend URL including '/api' (or without '/api', normalized automatically)
#   Example: https://core-quest-finder-backend.onrender.com/api
# - If deploying behind a reverse proxy (or local dev default):
#   Omit or set to '/api' for same-origin proxying.
VITE_API_URL=https://core-quest-finder-backend.onrender.com/api

# ------------------------------------------------------------------------------
# 2. CLIENT MODE FLAGS
# ------------------------------------------------------------------------------
# Disable mock mode in production (always false for live PostgreSQL gameplay)
VITE_USE_MOCK_API=false

# ------------------------------------------------------------------------------
# 3. SUPABASE PUBLIC CREDENTIALS (IF CLIENT SDK IS USED DIRECTLY)
# ------------------------------------------------------------------------------
# Safe to expose publicly if needed (only anon key, NEVER service role key!)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NOTE: NEVER expose ADMIN_PASSWORD, DATABASE_URL, or server secrets in frontend variables!
