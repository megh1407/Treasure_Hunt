# ==============================================================================
# CORE QUEST FINDER / UPDATES 2K26 — MASTER PRODUCTION ENVIRONMENT TEMPLATE
# Architecture:
#   - Frontend : Vercel (Vite + React)
#   - Backend  : Render (Node.js + Express)
#   - Database : Supabase PostgreSQL (Prisma ORM)
# ==============================================================================

# ==============================================================================
# SECTION A: BACKEND PRIVATE ENVIRONMENT VARIABLES (Set in Render Dashboard)
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Supabase PostgreSQL (Prisma ORM)
# 1. Transaction Pooler (Port 6543) - Used by Prisma Client runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# 2. Session / Direct Pooler (Port 5432) - Used for Prisma migrations (prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# CORS Security (Allowed Vercel Frontend Domain - NO trailing slashes, NO wildcard *)
CORS_ORIGIN="https://core-quest-finder.vercel.app"

# Organizer Control Room Master Secret (Used for /admin, telemetry, and Excel export)
ADMIN_PASSWORD="replace-with-a-secure-random-admin-password"

# Optional Supabase server-side key (if using Supabase storage/services)
# SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-DO-NOT-EXPOSE-TO-CLIENT"


# ==============================================================================
# SECTION B: FRONTEND PUBLIC ENVIRONMENT VARIABLES (Set in Vercel Dashboard)
# ==============================================================================

# Render Backend URL (Publicly accessible URL to Render Web Service)
VITE_API_URL="https://core-quest-finder-backend.onrender.com/api"

# Disable Mock API in Production
VITE_USE_MOCK_API=false

# Optional Supabase Public Anon Key (Safe for browser bundle)
# VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ==============================================================================
# SECURITY AUDIT REMINDER:
# - NEVER commit real .env files to Git.
# - NEVER put DATABASE_URL, DIRECT_URL, or ADMIN_PASSWORD into frontend Vercel variables.
# - NEVER run 'prisma migrate reset' in production. Always run 'prisma migrate deploy'.
# ==============================================================================
