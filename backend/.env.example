# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection Strings)
# Runtime connection via transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session pooler connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Admin Authentication
ADMIN_PASSWORD=replace-with-secure-admin-password