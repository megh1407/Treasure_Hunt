# ==============================================================================
# CORE QUEST FINDER — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Platform: Render Web Service (Node.js)
# Database: Supabase PostgreSQL (Prisma ORM)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Platform-assigned port (Render automatically provides $PORT)
PORT=5000

# Server network interface binding (Render requires 0.0.0.0)
HOST=0.0.0.0

# Node environment mode: 'production' suppresses stack traces & internal error details
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGURATION (PRISMA ORM)
# ------------------------------------------------------------------------------
# Runtime pooler connection (Supavisor Transaction Pooler, port 6543)
# Used by Express / Prisma Client for high-concurrency connection pooling.
# Format: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection (Session mode / direct PostgreSQL port 5432)
# Required by Prisma CLI for non-destructive migrations (`prisma migrate deploy`).
# Format: postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional Supabase public project URL and server-side secret (if using Supabase SDK/Storage)
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-never-expose-to-frontend"

# ------------------------------------------------------------------------------
# 3. CORS & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes, NO wildcard *)
# In production on Render, set this to your deployed Vercel domain(s):
CORS_ORIGIN="https://core-quest-finder.vercel.app,https://your-custom-domain.com"

# ------------------------------------------------------------------------------
# 4. ADMIN CONTROL ROOM AUTHENTICATION
# ------------------------------------------------------------------------------
# Master secret password for organizer access to /admin, live telemetry, and Excel export
ADMIN_PASSWORD="replace-with-a-strong-random-password-32chars"